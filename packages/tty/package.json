{
  "name": "dsh-tty",
  "version": "0.1.0",
  "description": "Terminal seam for DeepSeek Harness: allocate a PTY on whichever machine owns a workspace, and resize it while the shell inside keeps running.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lengmoXXL/dsh-remote-workspace.git",
    "directory": "packages/tty"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "pty",
    "terminal",
    "seam"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "sideEffects": false,
  "private": true
}
