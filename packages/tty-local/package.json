{
  "name": "dsh-tty-local",
  "version": "0.1.0",
  "description": "Local terminal provider for DeepSeek Harness: a PTY this host owns, resizable while its shell keeps running.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lengmoXXL/dsh-remote-workspace.git",
    "directory": "packages/tty-local"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "pty",
    "node-pty",
    "terminal"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "dsh-tty": "^0.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "dsh-tty": "^0.1.0",
    "node-pty": "^1.2.0-beta.15"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown",
    "pretest": "npm run build",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts"
  },
  "sideEffects": false,
  "private": true
}
