{
  "name": "dsh-remote-workspace-repo",
  "version": "0.0.1",
  "private": true,
  "description": "DeepSeek Harness plugins for working on other machines: a remote workspace manager, a terminal in the sidebar, and the PTY seam the two share.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lengmoXXL/dsh-remote-workspace.git"
  },
  "homepage": "https://github.com/lengmoXXL/dsh-remote-workspace#readme",
  "bugs": {
    "url": "https://github.com/lengmoXXL/dsh-remote-workspace/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "npm@10",
  "overrides": {
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-bash-sandbox": "0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:agent": "cargo build --release --manifest-path agent/Cargo.toml",
    "test:agent": "cargo test --manifest-path agent/Cargo.toml --tests",
    "test:browser": "npm run test:browser --workspace dsh-remote-workspace"
  }
}
